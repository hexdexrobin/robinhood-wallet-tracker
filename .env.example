# ============================================================
# Robinhood Wallet Tracker — copy to .env and fill values
#   cp .env.example .env
# Never commit .env
# ============================================================

# Alchemy Robinhood app API key
ALCHEMY_API_KEY=your_alchemy_api_key

# Alchemy Notify auth token (Dashboard → Notify)
ALCHEMY_AUTH_TOKEN=your_alchemy_auth_token

# Public HTTPS URL of this server ending with /webhook
# Example: https://tracker.yourdomain.com/webhook
WEBHOOK_URL=https://your-domain.com/webhook

PORT=3000

# Telegram bot (@BotFather) — control + alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Discord
# DISCORD_WEBHOOK_URL=

# --- Auto-buy when a tracked wallet launches a token ---
# Requires robinhood-uniswap-bot on the same machine with its own .env
AUTO_BUY_ENABLED=false
AUTO_BUY_ETH_AMOUNT=0.001
AUTO_BUY_SLIPPAGE=3
AUTO_BUY_TAKE_PROFIT=100
AUTO_BUY_STOP_LOSS=40
AUTO_BUY_AUTO_WATCH=true
AUTO_BUY_WATCH_INTERVAL=10
AUTO_BUY_DRY_RUN=true
AUTO_BUY_AMM_ONLY=true
AUTO_BUY_ONLY_LAUNCHPAD=false
UNISWAP_BOT_PATH=/root/robinhood-uniswap-bot
