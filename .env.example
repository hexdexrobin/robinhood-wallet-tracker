# Alchemy Dashboard → API key for your Robinhood Chain app
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Alchemy Dashboard → Notify tab → Auth Token (required for webhook create/update)
ALCHEMY_AUTH_TOKEN=your_alchemy_auth_token_here

# Public HTTPS URL Alchemy will POST webhook events to (use ngrok for local dev)
# Example: https://abc123.ngrok-free.app/webhook
WEBHOOK_URL=https://your-public-url.example.com/webhook

# Express server port
PORT=3000
